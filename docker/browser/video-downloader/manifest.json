{
  "manifest_version": 3,
  "name": "Chromine video downloader",
  "version": "1.3.1",
  "description": "Download the video on the current page with yt-dlp and upload it through Chromine.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["core.js", "floating.js", "player.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
