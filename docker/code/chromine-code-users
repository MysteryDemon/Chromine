#!/usr/lib/code-server/lib/node
"use strict";

const fs = require("fs");
const path = require("path");
const { spawn } = require("child_process");

const USERS_FILE = "/code-socket/users.json";
const SOCKETS = "/code-socket/users";
const LINKS = "/code-links/users";
const HOMES = "/home/chromine";
const UIDS = path.join(HOMES, ".uids.json");
const GROUP = 10000;
const FIRST_UID = 20001;
const LAST_UID = 59999;
const ID = /^[0-9a-f]{32}$/;
const NAME = /^[a-z0-9][a-z0-9._-]{2,31}$/;
const THEMES = { dark: "Default Dark Modern", light: "Default Light Modern" };
const ARGS = ["--auth", "none", "--socket-mode", "660", "--disable-workspace-trust", "--disable-telemetry", "--disable-update-check"];

const running = new Map();

function log(msg) {
  process.stderr.write(`chromine-code-users: ${msg}\n`);
}

function readUsers(file) {
  try {
    const u = JSON.parse(fs.readFileSync(file, "utf8"));
    if (u.schema !== 1 || !Array.isArray(u.known) || !Array.isArray(u.active)) return null;
    if (![...u.known, ...u.active].every((id) => typeof id === "string" && ID.test(id))) return null;
    const names = u.names && typeof u.names === "object" ? u.names : {};
    return { known: u.known, active: u.active.filter((id) => u.known.includes(id)), names };
  } catch {
    return null;
  }
}

function assignUids(saved, known) {
  const ids = {};
  let next = Number.isInteger(saved.next) && saved.next >= FIRST_UID ? saved.next : FIRST_UID;
  for (const id of known) {
    const uid = saved.ids && saved.ids[id];
    if (Number.isInteger(uid) && uid >= FIRST_UID && uid <= LAST_UID) {
      ids[id] = uid;
      next = Math.max(next, uid + 1);
    }
  }
  for (const id of known) {
    if (ids[id] !== undefined) continue;
    if (next > LAST_UID) throw new Error("no Linux user IDs left for VS Code users");
    ids[id] = next++;
  }
  return { next, ids };
}

function isOurs(line) {
  const id = Number(line.split(":")[2]);
  return id >= FIRST_UID && id <= LAST_UID;
}

function accountNames(users, uids, passwd) {
  const system = new Set(passwd.split("\n").filter((l) => l && !isOurs(l)).map((l) => l.split(":")[0]));
  const taken = new Set();
  const names = {};
  for (const id of users.known) {
    const wanted = users.names[id];
    const name = typeof wanted === "string" && NAME.test(wanted) && !system.has(wanted) && !taken.has(wanted) ? wanted : `user${uids.ids[id]}`;
    taken.add(name);
    names[id] = name;
  }
  return names;
}

function withAccounts(text, lines) {
  return [...text.split("\n").filter((l) => l && !isOurs(l)), ...lines].join("\n") + "\n";
}

function replaceFile(file, text) {
  if (fs.readFileSync(file, "utf8") === text) return;
  const tmp = `${file}.chromine`;
  fs.writeFileSync(tmp, text, { mode: 0o644 });
  fs.renameSync(tmp, file);
}

function writeAccounts(users, uids, names) {
  const passwd = users.known.map((id) => `${names[id]}:x:${uids.ids[id]}:${uids.ids[id]}:Chromine user:${path.join(HOMES, id)}:/bin/bash`);
  const groups = users.known.map((id) => `${names[id]}:x:${uids.ids[id]}:`);
  replaceFile("/etc/passwd", withAccounts(fs.readFileSync("/etc/passwd", "utf8"), passwd));
  replaceFile("/etc/group", withAccounts(fs.readFileSync("/etc/group", "utf8"), groups));
}

function dir(p, uid, gid, mode) {
  fs.mkdirSync(p, { recursive: true });
  fs.chownSync(p, uid, gid);
  fs.chmodSync(p, mode);
}

function ownedDirs(base, rel, uid) {
  let cur = base;
  for (const part of rel.split("/")) {
    cur = path.join(cur, part);
    if (!fs.existsSync(cur)) dir(cur, uid, uid, 0o700);
  }
  return cur;
}

function applyTheme(home, uid) {
  const theme = THEMES[process.env.VS_CODE_DEFAULT_THEME || "dark"];
  const userDir = ownedDirs(home, ".local/share/code-server/User", uid);
  const file = path.join(userDir, "settings.json");
  if (!theme || fs.existsSync(file)) return;
  fs.writeFileSync(file, JSON.stringify({ "workbench.colorTheme": theme }, null, 2) + "\n", { mode: 0o600 });
  fs.chownSync(file, uid, uid);
}

function killUid(uid) {
  for (const pid of fs.readdirSync("/proc").filter((n) => /^\d+$/.test(n))) {
    try {
      const status = fs.readFileSync(`/proc/${pid}/status`, "utf8");
      const ids = (status.match(/^Uid:\s+(.*)$/m) || ["", ""])[1].split(/\s+/).map(Number);
      if (ids.includes(uid)) process.kill(Number(pid), "SIGKILL");
    } catch {}
  }
}

function start(id, uid, name) {
  const home = path.join(HOMES, id);
  const workspace = path.join(home, "workspace");
  const sockets = path.join(SOCKETS, id);
  const links = path.join(LINKS, id);
  dir(home, uid, uid, 0o700);
  dir(workspace, uid, uid, 0o755);
  dir(sockets, uid, GROUP, 0o2770);
  dir(links, uid, GROUP, 0o2770);
  applyTheme(home, uid);
  const socket = path.join(sockets, "code.sock");
  fs.rmSync(socket, { force: true });
  const env = {
    HOME: home,
    USER: name,
    LOGNAME: name,
    SHELL: "/bin/bash",
    PATH: process.env.PATH || "/usr/local/bin:/usr/bin:/bin",
    LANG: process.env.LANG || "C.UTF-8",
    BROWSER: "/usr/bin/chromine-open",
    CHROMINE_LINKS_DIR: links,
  };
  if (process.env.TZ) env.TZ = process.env.TZ;
  const umask = process.umask(0o077);
  let child;
  try {
    child = spawn("/usr/bin/code-server", [...ARGS, "--socket", socket, workspace], {
      uid,
      gid: uid,
      env,
      cwd: workspace,
      detached: true,
      stdio: ["ignore", "inherit", "inherit"],
    });
  } finally {
    process.umask(umask);
  }
  const entry = { child, uid, stopping: false, exited: false, started: Date.now(), retryAt: 0, backoff: 2000 };
  const ended = (why) => {
    if (entry.exited) return;
    entry.exited = true;
    if (entry.stopping) return;
    entry.backoff = Date.now() - entry.started > 60000 ? 2000 : Math.min(entry.backoff * 2, 30000);
    entry.retryAt = Date.now() + entry.backoff;
    log(`VS Code for ${name} stopped (${why}); restarting`);
  };
  child.on("error", (e) => ended(e.message));
  child.on("exit", (code, signal) => ended(code ?? signal));
  log(`started VS Code for ${name}`);
  return entry;
}

function stop(id, entry) {
  entry.stopping = true;
  try {
    process.kill(-entry.child.pid, "SIGTERM");
  } catch {}
  setTimeout(() => {
    if (!entry.exited) killUid(entry.uid);
  }, 10000).unref();
  log(`stopping VS Code for user ${id}`);
}

function collectGarbage(known) {
  for (const root of [HOMES, SOCKETS, LINKS]) {
    let names = [];
    try {
      names = fs.readdirSync(root);
    } catch {
      continue;
    }
    for (const name of names) {
      if (ID.test(name) && !known.includes(name) && !running.has(name)) {
        fs.rmSync(path.join(root, name), { recursive: true, force: true });
        log(`removed a deleted user's files from ${root}`);
      }
    }
  }
}

function sync() {
  const users = readUsers(USERS_FILE);
  if (!users) return;
  let saved = {};
  try {
    saved = JSON.parse(fs.readFileSync(UIDS, "utf8"));
  } catch {}
  const uids = assignUids(saved, users.known);
  if (JSON.stringify(uids) !== JSON.stringify(saved)) fs.writeFileSync(UIDS, JSON.stringify(uids) + "\n", { mode: 0o600 });
  const names = accountNames(users, uids, fs.readFileSync("/etc/passwd", "utf8"));
  writeAccounts(users, uids, names);
  for (const [id, entry] of [...running]) {
    const active = users.active.includes(id);
    if (entry.exited) {
      if (entry.stopping || !active) {
        killUid(entry.uid);
        running.delete(id);
      } else if (Date.now() >= entry.retryAt) {
        killUid(entry.uid);
        running.set(id, start(id, uids.ids[id], names[id]));
      }
    } else if (!active && !entry.stopping) {
      stop(id, entry);
    }
  }
  for (const id of users.active) {
    if (!running.has(id)) running.set(id, start(id, uids.ids[id], names[id]));
  }
  collectGarbage(users.known);
}

function main() {
  dir(HOMES, 0, 0, 0o711);
  for (const [root, sub] of [["/code-socket", SOCKETS], ["/code-links", LINKS]]) {
    fs.chmodSync(root, 0o2771);
    dir(sub, 0, GROUP, 0o2771);
  }
  const tick = () => {
    try {
      sync();
    } catch (e) {
      log(e.message);
    }
  };
  tick();
  const timer = setInterval(tick, 2000);
  const shutdown = () => {
    clearInterval(timer);
    for (const [id, entry] of running) if (!entry.exited) stop(id, entry);
    const waitUntil = Date.now() + 8000;
    const check = setInterval(() => {
      if ([...running.values()].every((e) => e.exited) || Date.now() > waitUntil) {
        for (const entry of running.values()) killUid(entry.uid);
        process.exit(0);
      }
    }, 200);
  };
  process.on("SIGTERM", shutdown);
  process.on("SIGINT", shutdown);
}

if (require.main === module) main();
else module.exports = { readUsers, assignUids, accountNames, withAccounts };
