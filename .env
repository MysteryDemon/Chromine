
# REQUIRED. Dashboard login name.
APP_AUTH_USER=admin

# REQUIRED. Dashboard password, at least 12 characters. Wrap it in single
# quotes if it contains $ or #. Changing it signs out every session.
APP_AUTH_PASSWORD=""

STREAM_MODE=webrtc
DEFAULT_THEME=dark

# Session lifetime in hours.
APP_SESSION_TTL_HOURS=12
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080



# DOWNLOAD_DIR=/downloads
# STATE_DIR=/state

# Delete the local file after the upload succeeded and the link was saved.
# false keeps every file.
DELETE_AFTER_SUCCESS=true

# Refuse new downloads (and cancel running ones) when the download volume
# has less free space than this. Default 2 GiB.
MIN_FREE_DISK_BYTES=2147483648

# ------------------------------------------------------------ filecloud24

# Administrator-controlled service URL.
FILECLOUD_BASE_URL=https://filecloud24.cc

# Timeout for a single API request (one part is at most chunk_size bytes,
# currently 8 MiB). Raise it on slow uplinks.
UPLOAD_REQUEST_TIMEOUT_SECS=300

# Failed attempts (per stage) before a job is marked failed and waits for a
# manual Retry. Rate limits and flood waits do not count.
MAX_RETRY_ATTEMPTS=8

# ---------------------------------------------------------------- browser

# Shared memory for Chrome. Raise it if tabs crash ("Aw, Snap!").
CHROME_SHM_SIZE=2gb
SCREEN_WIDTH=1600
SCREEN_HEIGHT=900
BROWSER_LANG=C.UTF-8
TZ=UTC

# ------------------------------------------------------------------- logs

# error | warn | info | debug, or a full filter such as info,chromine_worker=debug
LOG_LEVEL=info
# text | json
LOG_FORMAT=text
VNC_PROXY_SECRET=39de45322226bd2ca294c1f3cd66ba265ae8dce77ab2d3e967820c374fdef6cc
